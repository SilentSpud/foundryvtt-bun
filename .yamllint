---
extends: default

rules:
  braces:
    forbid: non-empty
    # Ansible compatibility.
    max-spaces-inside: 1

  brackets:
    forbid: non-empty

  comments:
    # Ansible compatibility.
    min-spaces-from-content: 1

  # Fails on commented-out parts of dicts in a list (adrienverge/yamllint#384).
  comments-indentation: disable

  indentation:
    indent-sequences: true
    spaces: 2

  # Long keys and hashes cannot reasonably be wrapped.
  line-length:
    # This rule implies the allow-non-breakable-words rule
    allow-non-breakable-inline-mappings: true
    # SHA-pinned actions and issue template placeholders cannot wrap sanely.
    ignore: |
      /.github/workflows/*.yml
      /.github/ISSUE_TEMPLATE/*.yml
    # Allows a 10% overage from the default limit of 80
    max: 88

  # Non-string octals are unsafe for Ansible:
  # https://ansible.readthedocs.io/projects/lint/rules/risky-octal/
  octal-values:
    forbid-explicit-octal: true
    forbid-implicit-octal: true

  quoted-strings:
    allow-quoted-quotes: true
    check-keys: true
    quote-type: double
    required: only-when-needed
