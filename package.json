{
  "name": "foundryvtt-utils",
  "version": "14.369.1",
  "private": true,
  "description": "Utilities to help boot a FoundryVTT server.",
  "keywords": [
    "bun",
    "docker",
    "foundryvtt"
  ],
  "homepage": "https://github.com/SilentSpud/foundryvtt-bun#readme",
  "bugs": {
    "url": "https://github.com/SilentSpud/foundryvtt-bun/issues"
  },
  "license": "MIT",
  "author": "Silent Spud <1478389+SilentSpud@users.noreply.github.com>",
  "contributors": [
    "Mark Feldhousen <markf+github@geekpad.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilentSpud/foundryvtt-bun.git"
  },
  "type": "module",
  "scripts": {
    "build": "bun tools/build.ts",
    "check:files": "bun tools/check_files.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "image": "bun tools/bake.ts",
    "lint": "bun run typecheck && oxlint && bun run format:check && bun run check:files",
    "release": "bun pm version --no-git-tag-version",
    "test": "bun test tests/unit",
    "test:container": "bun test --timeout 600000 tests/container",
    "typecheck": "bun check",
    "version": "bun tools/version.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "fetch-cookie": "^3.2.0",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
