{
  "name": "foundryvtt-utils",
  "version": "3.0.0",
  "private": true,
  "description": "Utilities to help boot a FoundryVTT server.",
  "keywords": [
    "bun",
    "docker",
    "foundryvtt"
  ],
  "homepage": "https://github.com/felddy/foundryvtt-docker#readme",
  "bugs": {
    "url": "https://github.com/felddy/foundryvtt-docker/issues"
  },
  "license": "MIT",
  "author": "Mark Feldhousen <markf+github@geekpad.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felddy/foundryvtt-docker.git"
  },
  "type": "module",
  "scripts": {
    "build": "bun tools/build.ts",
    "bump-version": "bun tools/bump_version.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "image": "bun tools/bake.ts",
    "lint": "bun check && oxlint && bun run format:check",
    "release": "bun tools/bump_version.ts set",
    "ruleset:apply": "bun tools/rulesets.ts apply",
    "ruleset:export": "bun tools/rulesets.ts export",
    "setup": "bun tools/setup_env.ts",
    "tag": "bun tools/tag.ts",
    "test": "bun test tests/unit",
    "test:container": "bun test --timeout 600000 tests/container",
    "version": "bun tools/version.ts"
  },
  "dependencies": {
    "fetch-cookie": "^3.2.0",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
