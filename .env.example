# Copy to .env and fill in.  compose.yaml substitutes these values into its
# environment section; any other variable listed there can be set here too.
# The container tests (bun run test:container) use the credentials to
# download and start a real release.  Never commit .env.
FOUNDRY_USERNAME=<your_username>
FOUNDRY_PASSWORD=<your_password>
FOUNDRY_ADMIN_KEY=<your_admin_key>
